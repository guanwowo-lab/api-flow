      { "name": "returnType", "label": "申请售后类型", "required": true, "type": "enum", "options": ["1001", "1002", "1003"], "optionLabels": ["1001-退货退款(有货物寄回)", "1002-仅退款(无货物寄回)", "1003-退货换货"] },
      { "name": "returnReasonType", "label": "申请售后的原因类型", "required": true, "type": "enum", "options": ["1001", "1002", "1003", "1004", "1005", "1006", "1007", "1008", "1009", "1010", "1011", "1012", "1013", "1014", "1015", "1016"], "optionLabels": ["1001-商品无货", "1002-发货时间问题", "1003-不想要了/不喜欢", "1004-商品信息填写错误", "1005-地址信息填写错误", "1006-商品降价", "1007-其他", "1008-尺码不合适", "1009-无理由退货", "1010-发票问题", "1011-商品与页面描述不符", "1012-发错货", "1013-质量问题", "1014-买错尺码/颜色/型号", "1015-商品缺少或破损", "1016-买错了"] },
      { "name": "returnContent", "label": "申请售后的内容描述", "required": true, "type": "string", "desc": "最多不超过256个字" },
      { "name": "returnVoucherImg", "label": "售后图片凭证链接", "required": false, "type": "string", "desc": "多个以英文逗号隔开，最多支持5个图片凭证" },
      { "name": "goodsSkuCode", "label": "订单中购买的商品SKU编码", "required": true, "type": "string", "desc": "申请售后的原订单中购买的商品sku编码" },
      { "name": "applyQty", "label": "商品申请售后的数量", "required": true, "type": "number", "desc": "申请售后的商品数量" }
    ],
    "outputParams": [
      { "name": "success", "docType": "Boolean", "docDesc": "接口成功与否标识" },
      { "name": "code", "docType": "String", "docDesc": "接口业务编码" },
      { "name": "desc", "docType": "String", "docDesc": "接口调用错误提示或成功提示" },
      { "name": "result.orderCode", "docType": "String", "docDesc": "云中鹤子订单编号" },
      { "name": "result.returnOrderCode", "docType": "String", "docDesc": "云中鹤售后订单编号" },
      { "name": "result.tparReturnOrderCode", "docType": "String", "docDesc": "客户方售后订单编号" },
      { "name": "time", "docType": "Long", "docDesc": "接口返回数据的时间戳" }
    ],
    "responseMapping": { "successField": "success", "codeField": "code" }
  },
