  {
    "id": "createAfterSalesOrder",
    "name": "提交售后订单",
    "category": "售后订单服务",
    "method": "POST",
    "path": "/open/api/afterSalesOrder/createAfterSalesOrder",
    "signRequired": false,
    "params": [
      { "name": "accessToken", "label": "接口授权访问令牌", "required": true, "type": "string", "autoFill": "accessToken" },
      { "name": "orderCode", "label": "云中鹤子订单编号", "required": true, "type": "string", "desc": "申请售后时以云中鹤子订单编号去申请" },
