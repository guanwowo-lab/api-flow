      { "name": "result.tparOrderCode", "docType": "String", "docDesc": "客户方订单编号" },
      { "name": "result.parentOrderCode", "docType": "String", "docDesc": "云中鹤父订单编号" },
      { "name": "time", "docType": "Long", "docDesc": "接口返回数据的时间戳" }
    ],
    "responseMapping": { "successField": "success", "codeField": "code" }
  },
  {
    "id": "cancelOrder",
    "name": "取消订单",
    "category": "订单服务",
    "method": "POST",
    "path": "/open/api/order/cancelOrder",
    "signRequired": false,
    "params": [
      { "name": "accessToken", "label": "接口授权访问令牌", "required": true, "type": "string", "autoFill": "accessToken" },
      { "name": "tparOrderCode", "label": "客户方订单编号", "required": false, "type": "string", "desc": "tparOrderCode、parentOrderCode、orderCode至少传一个" },
      { "name": "parentOrderCode", "label": "云中鹤父订单编号", "required": false, "type": "string", "desc": "tparOrderCode、parentOrderCode、orderCode至少传一个" },
      { "name": "orderCode", "label": "云中鹤子订单编号", "required": false, "type": "string", "desc": "云中鹤拆单后的子订单号" }
    ],
    "outputParams": [
      { "name": "success", "docType": "Boolean", "docDesc": "接口成功与否标识" },
      { "name": "code", "docType": "String", "docDesc": "接口业务编码" },
      { "name": "desc", "docType": "String", "docDesc": "接口调用错误提示或成功提示" },
      { "name": "result.tparOrderCode", "docType": "String", "docDesc": "客户方订单编号" },
      { "name": "result.parentOrderCode", "docType": "String", "docDesc": "云中鹤父订单编号" },
      { "name": "result.cancelStatus", "docType": "Integer", "docDesc": "取消处理状态(1000:取消成功,1010:取消审核中)" },
      { "name": "time", "docType": "Long", "docDesc": "接口返回数据的时间戳" }
    ],
    "responseMapping": { "successField": "success", "codeField": "code" }
  },
  {
    "id": "queryOrderList",
    "name": "获取订单列表",
    "category": "订单服务",
