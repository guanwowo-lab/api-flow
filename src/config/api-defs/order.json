[
  {
    "id": "submitOrder",
    "name": "提交订单",
    "category": "订单服务",
    "method": "POST",
    "path": "/open/api/order/createOrder",
    "signRequired": false,
    "params": [
      { "name": "accessToken", "label": "接口授权访问令牌", "required": true, "type": "string", "autoFill": "accessToken" },

      { "name": "tparOrderCode", "label": "客户方订单编号（可为空）", "required": false, "type": "string", "desc": "客户方自己的订单编号，建议传值以便后续用客户订单号操作" },

      { "name": "orderAmount", "label": "订单交易总金额", "required": true, "type": "number", "desc": "提交订单的总金额，不包括运费" },
      { "name": "orderFreightAmount", "label": "订单运费总金额", "required": true, "type": "number", "desc": "包邮传0" },

      { "name": "submitState", "label": "是否预占订单", "required": true, "type": "enum", "options": ["1001", "1002"], "optionLabels": ["1001-预占库存(草稿，需再调确认预占接口)", "1002-直接生成正式订单"], "default": "1001", "desc": "1001预占库存不实际下单，需调确认预占接口；1002直接下单" },

      { "name": "receiveName", "label": "收货人姓名", "required": true, "type": "string" },
      { "name": "receiveMobile", "label": "收货人手机号", "required": false, "type": "string", "desc": "与receivePhone至少填一个" },
      { "name": "receivePhone", "label": "收货人座机号", "required": false, "type": "string", "desc": "与receiveMobile至少填一个" },

      { "name": "provinceId", "label": "收货人省Id编码", "required": true, "type": "number", "desc": "必须是云中鹤地址库的地址编码" },
      { "name": "cityId", "label": "收货人市Id编码", "required": true, "type": "number", "desc": "必须是云中鹤地址库的地址编码" },
      { "name": "countyId", "label": "收货人区Id编码", "required": true, "type": "number", "desc": "必须是云中鹤地址库的地址编码" },
      { "name": "townId", "label": "收货人镇/街道Id编码", "required": false, "type": "number", "desc": "必须是云中鹤地址库的地址编码" },

      { "name": "address", "label": "收货人详细地址", "required": true, "type": "string" },
      { "name": "buyerMsg", "label": "订单买家留言", "required": false, "type": "string" },

      { "name": "invoiceState", "label": "是否开发票", "required": true, "type": "enum", "options": ["1001", "1002"], "optionLabels": ["1001-不开发票", "1002-开发票"], "default": "1001", "desc": "1001不开发票，1002需要开发票（发票信息必填）" },
      { "name": "invoiceType", "label": "发票类型", "required": false, "type": "enum", "options": ["", "1", "2"], "optionLabels": ["不填", "1-增值税专用发票", "2-增值税普通电子发票"], "desc": "invoiceState=1002时此字段不能为空" },
      { "name": "invoiceTitle", "label": "发票抬头", "required": false, "type": "string", "desc": "invoiceState=1002时此字段不能为空" },
      { "name": "invoiceContent", "label": "发票内容", "required": false, "type": "string", "desc": "invoiceState=1002时此字段不能为空" },
      { "name": "invoiceSubjectType", "label": "开票主体类型", "required": false, "type": "enum", "options": ["", "1001", "1002"], "optionLabels": ["不填", "1001-企业", "1002-个人"], "desc": "invoiceState=1002时此字段不能为空" },
      { "name": "invoiceTaxNo", "label": "发票税号", "required": false, "type": "string" },

      { "name": "goodsSkuCodes", "label": "商品SKU编码（逗号分隔）", "required": true, "type": "string", "desc": "订单购买的商品SKU编码，多个用逗号分隔" },
      { "name": "sellPrices", "label": "商品单价（逗号分隔）", "required": true, "type": "string", "desc": "与goodsSkuCodes按位置一一对应" },
      { "name": "sellQtys", "label": "商品数量（逗号分隔）", "required": true, "type": "string", "desc": "与goodsSkuCodes按位置一一对应" }
    ],
    "outputParams": [
      { "name": "success", "docType": "Boolean", "docDesc": "接口成功与否标识" },
      { "name": "code", "docType": "String", "docDesc": "接口业务编码，00000表示成功" },
      { "name": "desc", "docType": "String", "docDesc": "接口调用错误提示或成功提示" },
      { "name": "result", "docType": "Object", "docDesc": "接口返回的业务数据" },
      { "name": "result.tparOrderCode", "docType": "String", "docDesc": "客户方订单编号" },
      { "name": "result.parentOrderCode", "docType": "String", "docDesc": "云中鹤父订单号(未拆单前的订单号)" },
      { "name": "time", "docType": "Long", "docDesc": "接口返回数据的时间戳" }
    ],
    "responseMapping": { "successField": "success", "codeField": "code" }
  },
  {
    "id": "confirmOrder",
