    "path": "/open/api/order/queryOrderList",
    "signRequired": false,
    "params": [
      { "name": "accessToken", "label": "接口授权访问令牌", "required": true, "type": "string", "autoFill": "accessToken" },
      { "name": "pageNum", "label": "分页页码", "required": false, "type": "number", "default": 1, "desc": "不传默认为第1页" },
      { "name": "pageSize", "label": "每页数据条数", "required": false, "type": "number", "default": 100, "desc": "不传默认为100条，最大不超过100" },
      { "name": "tparOrderCode", "label": "客户方订单编号", "required": false, "type": "string" },
      { "name": "parentOrderCode", "label": "云中鹤父订单编号", "required": false, "type": "string" },
      { "name": "orderCode", "label": "云中鹤子订单编号", "required": false, "type": "string", "desc": "拆单后的子订单编号" }
    ],
    "outputParams": [
      { "name": "success", "docType": "Boolean", "docDesc": "接口成功与否标识" },
      { "name": "code", "docType": "String", "docDesc": "接口业务编码" },
      { "name": "desc", "docType": "String", "docDesc": "接口调用错误提示或成功提示" },
      { "name": "result.pageNum", "docType": "Integer", "docDesc": "当前分页页码" },
      { "name": "result.pageSize", "docType": "Integer", "docDesc": "当前分页每页数据条数" },
      { "name": "result.totalCount", "docType": "Integer", "docDesc": "当前数据总条数" },
      { "name": "result.totalPage", "docType": "Integer", "docDesc": "当前数据总页数" },
      { "name": "result.orderList", "docType": "Array", "docDesc": "订单信息列表" },
      { "name": "result.orderList[].tparOrderCode", "docType": "String", "docDesc": "客户方订单编号" },
      { "name": "result.orderList[].parentOrderCode", "docType": "String", "docDesc": "云中鹤父订单编号" },
      { "name": "result.orderList[].parentOrderAmount", "docType": "Double", "docDesc": "父订单交易总金额" },
      { "name": "result.orderList[].orderFreightAmount", "docType": "Double", "docDesc": "父订单交易总运费" },
      { "name": "result.orderList[].buyerMsg", "docType": "String", "docDesc": "买家留言" },
      { "name": "result.orderList[].childOrderList", "docType": "Array", "docDesc": "子订单列表" },
      { "name": "result.orderList[].childOrderList[].orderCode", "docType": "String", "docDesc": "子订单编号(云中鹤拆单后的订单编号)" },
      { "name": "result.orderList[].childOrderList[].orderAmount", "docType": "Double", "docDesc": "子订单交易总金额" },
      { "name": "result.orderList[].childOrderList[].createTime", "docType": "Date", "docDesc": "子订单创建时间" },
      { "name": "time", "docType": "Long", "docDesc": "接口返回数据的时间戳" }
    ],
    "responseMapping": { "successField": "success", "codeField": "code" }
  },
